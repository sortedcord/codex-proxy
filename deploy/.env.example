# Copy to deploy/.env or pass with --env-file.
# Real credentials must NEVER be committed.

# Required: secret inference key for clients calling /v1/*
CODEX_PROXY_API_KEY=

# Optional: distinct administrator key enabling /status/* and /config/*
# Leave empty to keep management routes disabled.
CODEX_PROXY_MANAGEMENT_KEY=

# Optional: host interface and port to bind (defaults to loopback on 8081)
# CODEX_PROXY_BIND_ADDR=127.0.0.1:8081

# Optional: override published image tag or use an exact digest
# CODEX_PROXY_IMAGE=ghcr.io/sortedcord/codex-proxy:0.5.0
