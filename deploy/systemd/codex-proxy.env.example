# Install as /etc/codex-proxy/codex-proxy.env, root:root mode 0600.
# systemd EnvironmentFile syntax, NOT a shell script: no export, substitutions,
# or inline comments. Supply real keys only in the installed private file.
CODEX_PROXY_ADDR=127.0.0.1:8081

# Empty is allowed on loopback. Set a private random key to protect inference.
# A non-loopback address REQUIRES a nonempty inference key, plus TLS/firewall.
CODEX_PROXY_API_KEY=

# Empty disables management, runtime login, quota polling, and history.
# To enable them, set a DIFFERENT private random administrator key.
CODEX_PROXY_MANAGEMENT_KEY=

# Credential/history paths are fixed by the service's ExecStart flags.
# Optional tuning (uncomment only if needed):
# CODEX_PROXY_QUOTA_POLL_INTERVAL=5m
